REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
SCREENSHOT_QUEUE_NAME=screenshots
SCREENSHOT_RESULT_QUEUE=screenshot-results
SCREENSHOT_WORKER_HEARTBEAT_KEY=screenshot-worker:heartbeat
SCREENSHOT_WORKER_HEARTBEAT_TTL=30
SCREENSHOT_WORKER_HEARTBEAT_INTERVAL=10
SCREENSHOT_DEFAULT_STEALTH=false
SCREENSHOT_DEFAULT_LOCALE=en-US
SCREENSHOT_DEFAULT_TIMEZONE=America/Los_Angeles
SCREENSHOT_DEFAULT_USER_AGENT=
SCREENSHOT_DEFAULT_ACCEPT_LANGUAGE=en-US,en;q=0.9
SCREENSHOT_DEFAULT_ACCEPT=
BROWSER_CONCURRENCY=3
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
STORAGE_PATH=/app/storage/app/screenshots
