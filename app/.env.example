APP_NAME=Captura
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
APP_VERSION=0.1.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=captura
DB_USERNAME=captura
DB_PASSWORD=secret

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Screenshot defaults
SCREENSHOT_DEFAULT_WIDTH=1280
SCREENSHOT_DEFAULT_HEIGHT=800
SCREENSHOT_DEFAULT_FORMAT=png
SCREENSHOT_DEFAULT_QUALITY=80
SCREENSHOT_DEFAULT_STEALTH=false
SCREENSHOT_DEFAULT_LOCALE=en-US
SCREENSHOT_DEFAULT_TIMEZONE=America/Los_Angeles
SCREENSHOT_DEFAULT_USER_AGENT=
SCREENSHOT_DEFAULT_ACCEPT_LANGUAGE=en-US,en;q=0.9
SCREENSHOT_DEFAULT_ACCEPT=

# Limits
SCREENSHOT_MAX_WIDTH=3840
SCREENSHOT_MAX_HEIGHT=2160
SCREENSHOT_TIMEOUT=30

# Caching
SCREENSHOT_CACHE_ENABLED=true
SCREENSHOT_CACHE_TTL=3600

# Storage
SCREENSHOT_STORAGE_PATH=screenshots
SCREENSHOT_PUBLIC_URL=http://localhost/screenshots

# Proxy pool (comma-separated list)
SCREENSHOT_PROXY_POOL_ENABLED=false
SCREENSHOT_PROXY_POOL=
SCREENSHOT_PROXY_STRATEGY=random
SCREENSHOT_PROXY_CACHE_KEY=screenshot:proxy:rr

# Rate limiting (requests per minute, 0 = disabled)
SCREENSHOT_RATE_LIMIT=60
SCREENSHOT_ALLOW_LOCALHOST=false
SCREENSHOT_ALLOWED_HOSTS=

# Optional API key
SCREENSHOT_API_KEY=

# Cleanup (hours, 0 = never)
SCREENSHOT_CLEANUP_AFTER=24

# Node worker queues
SCREENSHOT_QUEUE_NAME=screenshots
SCREENSHOT_RESULT_QUEUE=screenshot-results
SCREENSHOT_WORKER_HEARTBEAT_KEY=screenshot-worker:heartbeat
SCREENSHOT_WORKER_HEARTBEAT_TTL=30
SCREENSHOT_WORKER_HEARTBEAT_INTERVAL=10

# Blocked hosts
SCREENSHOT_BLOCKED_HOSTS=localhost,127.0.0.1,*.local,10.*,172.16.*,192.168.*
